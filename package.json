{
  "name": "shopsmart",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog:build": "node scripts/catalog/build.mjs",
    "catalog:test": "node --test scripts/catalog/",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
